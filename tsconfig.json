{
  "compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "node",
		"lib": ["esnext"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["@cloudflare/workers-types"],
		"resolveJsonModule": true
	},
  "include": ["src"],
  "exclude": ["node_modules"]
}
